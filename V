#!/bin/bash

echo "============================================="
echo "   Arix Theme Installer for Pterodactyl      "
echo "   Customized for SKA HOST (SDGAMER)         "
echo "============================================="

# ১. প্যানেল ডিরেক্টরিতে যাওয়া
echo "[1/6] Moving to Pterodactyl directory..."
cd /var/www/pterodactyl || { echo "Directory not found!"; exit 1; }

# ২. GitHub থেকে ফাইল আনা এবং সেটআপ করা
echo "[2/6] Downloading Theme Files from GitHub..."
git clone https://github.com/raolityle/Arix.git temp_arix
cp -rvT temp_arix/ /var/www/pterodactyl/
rm -rf temp_arix

# ৩. ডিপেনডেন্সি আপডেট (ভার্সন ফিক্স করার জন্য)
echo "[3/6] Installing Dependencies (Composer)..."
composer install --no-dev --optimize-autoloader

# ৪. ডাটাবেস মাইগ্রেশন এবং থিম ইনস্টল (৫০০ এরর ফিক্স)
echo "[4/6] Running Arix Setup & Database Migration..."
php artisan migrate --force
php artisan arix

# ৫. ক্যাশ ক্লিয়ার করা
echo "[5/6] Clearing Cache..."
php artisan view:clear
php artisan config:clear
php artisan cache:clear
php artisan optimize:clear

# ৬. স্টোরেজ পারমিশন এবং ওনারশিপ ঠিক করা
echo "[6/6] Setting Correct Permissions..."
chmod -R 755 storage/* bootstrap/cache
chown -R www-data:www-data /var/www/pterodactyl/*

# ৭. প্রোডাকশন বিল্ড (ডিজাইন ঠিক করার জন্য)
echo "[7/7] Building Assets..."
if command -v yarn &> /dev/null; then
    yarn install
    yarn run build:production
else
    npm install
    npm run build:production
fi

echo "============================================="
echo "   Installation Completed Successfully!      "
echo "   Please refresh your panel now.            "
echo "============================================="

